# Application Configuration
APP_NAME="IntelliChat AI"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Security & Authentication
# Generate a secure key in production with: openssl rand -hex 32
SECRET_KEY="super-secret-production-jwt-key-change-in-production-12345678"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# For PostgreSQL (Production):
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/chatbot"
# For SQLite (Instant Zero-Config Development):
DATABASE_URL="sqlite+aiosqlite:///./chatbot.db"

# LLM Providers Configuration
# Supported options: "groq", "openai", "gemini", "huggingface", "mock"
DEFAULT_LLM_PROVIDER="mock"
DEFAULT_MODEL="smart-assistant-v1"

# API Keys (Optional - if left empty, application seamlessly falls back to Smart Mock Assistant)
GROQ_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""
HUGGINGFACE_API_KEY=""

# CORS Settings (comma-separated list of allowed origins)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"
